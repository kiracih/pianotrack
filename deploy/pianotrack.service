[Unit]
Description=Piano practice tracker (MIDI collector + dashboard)
After=network-online.target sound.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
SupplementaryGroups=audio
WorkingDirectory=@DIR@
Environment=PIANOTRACK_DB=/var/lib/pianotrack/pianotrack.db
Environment=PYTHONUNBUFFERED=1
# The Pi has no hardware clock: wait (up to 90 s) for network time so session
# timestamps are right, but start anyway if the Pi is offline.
ExecStartPre=-/bin/sh -c 'for i in $$(seq 90); do [ "$$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = yes ] && exit 0; sleep 1; done'
TimeoutStartSec=120
ExecStart=/usr/bin/python3 -m pianotrack run --port @PORT@
Restart=always
RestartSec=3
StateDirectory=pianotrack
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
